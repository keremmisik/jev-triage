# Copy to .env and fill in. Never commit .env.

# TypeSafe API key (https://console.typesafe.ai/keys). Required for TRIAGE_BACKEND=jev.
TYPESAFE_API_KEY=

# jev = Jev with rule-based fallback, heuristic = rules only (no API calls)
TRIAGE_BACKEND=jev
TRIAGE_TYPESAFE_MODEL=jev-latest

# Routing thresholds (see src/jev_triage/router.py)
TRIAGE_REVIEW_MIN_CONFIDENCE=0.50
TRIAGE_AUTO_MIN_CONFIDENCE=0.80
TRIAGE_PAGE_RISK_THRESHOLD=0.60

# Optional: POST page/ticket/human_review decisions to this URL
TRIAGE_WEBHOOK_URL=

# Grafana admin password for the demo stack
GF_ADMIN_PASSWORD=change-me
